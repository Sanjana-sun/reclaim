# Copy to .env and fill in. Every value is OPTIONAL — the app runs with none of them.
# Each key you add lights up a real integration:

# 1. Real Claude-drafted appeals (else template fallback)
ANTHROPIC_API_KEY=
DRAFT_MODEL=claude-opus-4-8
CLASSIFY_MODEL=claude-haiku-4-5-20251001
# Drafting uses the RAG + tool-use agent (server/agent.js) by default when a key is set.
# Set DRAFT_AGENT=false to use the simpler single-shot drafter instead.
DRAFT_AGENT=true

# 2. Postgres instead of the local JSON file store. Example:
#    DATABASE_URL=postgres://localhost:5432/overturn
DATABASE_URL=

# 3. Real Stripe payments (else an auto-succeeding stub for local dev)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` or the Dashboard; used to verify webhook signatures.
STRIPE_WEBHOOK_SECRET=
# Recurring price for the $12/mo Plus plan (Stripe Billing). Enables subscription checkout.
STRIPE_PRICE_ID=

# Core config
JWT_SECRET=dev-secret-change-me
APPEAL_PRICE=40
CONTINGENCY_RATE=0.25
PORT=3000

# Public base URL (used in emails / share links), e.g. https://overturn-production.up.railway.app
APP_URL=

# Transactional email (deadline reminders, password reset). Without it, emails log to console.
RESEND_API_KEY=
EMAIL_FROM=Reclaim <onboarding@resend.dev>

# Auth rate limit (requests per 15 min per IP)
AUTH_RATE_MAX=100

# Production: set SEED_DEMO=false to skip the demo login accounts, and provide your own admin.
SEED_DEMO=true
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional analytics (e.g. Plausible): domain + script src
ANALYTICS_DOMAIN=
ANALYTICS_SRC=
